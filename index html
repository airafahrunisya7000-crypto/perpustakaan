<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Perpustakaan Digital Modern</title>
  <style>
    * {margin: 0; padding: 0; box-sizing: border-box; font-family: 'Segoe UI', sans-serif;}
    
    body {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      min-height: 100vh;
      padding: 20px;
      color: #333;
    }

    .container {
      max-width: 1200px;
      margin: auto;
      background: rgba(255,255,255,0.95);
      border-radius: 20px;
      padding: 30px;
      box-shadow: 0 20px 60px rgba(0,0,0,0.3);
    }

    h1 {
      text-align: center;
      color: #667eea;
      margin-bottom: 10px;
      font-size: 2.5em;
    }
    .subtitle {text-align: center; color: #777; margin-bottom: 30px;}

    /* MENU TAB */
    .menu {
      display: flex;
      gap: 10px;
      margin-bottom: 30px;
      flex-wrap: wrap;
      justify-content: center;
    }
    .tab-btn {
      background: #e0e7ff;
      border: none;
      padding: 12px 25px;
      border-radius: 50px;
      cursor: pointer;
      font-weight: bold;
      color: #667eea;
      transition: 0.3s;
    }
    .tab-btn.active {
      background: #667eea;
      color: white;
      transform: translateY(-2px);
      box-shadow: 0 5px 15px rgba(102,126,234,0.4);
    }

    /* ISI TAB */
    .tab-content {display: none;}
    .tab-content.active {display: block; animation: fadeIn 0.5s;}
    @keyframes fadeIn {from{opacity:0; transform:translateY(10px)} to{opacity:1; transform:translateY(0)}}

    /* KARTU BUKU */
    .buku-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 20px;
      margin-bottom: 20px;
    }
    .card {
      background: white;
      border-radius: 15px;
      padding: 20px;
      box-shadow: 0 5px 20px rgba(0,0,0,0.1);
      transition: 0.3s;
      border: 2px solid transparent;
    }
    .card:hover {
      transform: translateY(-5px);
      border-color: #667eea;
    }
    .card h3 {color: #667eea; margin-bottom: 8px;}
    .btn {
      background: linear-gradient(135deg, #667eea, #764ba2);
      color: white;
      border: none;
      padding: 10px 15px;
      border-radius: 10px;
      cursor: pointer;
      width: 100%;
      font-weight: bold;
      margin-top: 10px;
      transition: 0.3s;
    }
    .btn:hover {opacity: 0.8; transform: scale(1.02);}

    /* FORM */
    .form-box {
      background: #f8f9ff;
      padding: 25px;
      border-radius: 15px;
      max-width: 500px;
      margin: auto;
    }
    input, select {
      width: 100%;
      padding: 12px;
      margin: 8px 0;
      border: 2px solid #ddd;
      border-radius: 10px;
      font-size: 16px;
    }
    input:focus {border-color: #667eea; outline: none;}

    /* RIWAYAT */
    .riwayat {
      margin-top: 20px;
      background: #fff8e1;
      padding: 20px;
      border-radius: 15px;
    }
    .item-pinjam {
      background: white;
      padding: 15px;
      border-radius: 10px;
      margin: 10px 0;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    /* POP UP KONFIRMASI */
    .popup {
      display: none;
      position: fixed;
      top: 0; left: 0;
      width: 100%; height: 100%;
      background: rgba(0,0,0,0.6);
      justify-content: center;
      align-items: center;
      z-index: 999;
    }
    .popup-box {
      background: white;
      padding: 30px;
      border-radius: 20px;
      text-align: center;
      max-width: 400px;
      animation: pop 0.3s;
    }
    @keyframes pop {from{transform:scale(0.7)} to{transform:scale(1)}}
    .btn-oke {background: #28a745; color: white; border: none; padding: 10px 20px; border-radius: 10px; margin: 5px; cursor: pointer;}
    .btn-tidak {background: #dc3545; color: white; border: none; padding: 10px 20px; border-radius: 10px; margin: 5px; cursor: pointer;}
  </style>
</head>
<body>
  <div class="container">
    <h1>📚 PERPUSTAKAAN DIGITAL</h1>
    <p class="subtitle">Modern • Cepat • Tanpa Ribet</p>

    <div class="menu">
      <button class="tab-btn active" onclick="bukaTab('daftar')">1. Pendaftaran</button>
      <button class="tab-btn" onclick="bukaTab('pinjam')">2. Peminjaman</button>
      <button class="tab-btn" onclick="bukaTab('kembali')">3. Pengembalian</button>
    </div>

    <!-- TAB 1: PENDAFTARAN -->
    <div id="daftar" class="tab-content active">
      <div class="form-box">
        <h2>Form Pendaftaran Anggota</h2>
        <input type="text" id="nama" placeholder="Nama Lengkap">
        <input type="text" id="nis" placeholder="NIS / ID Anggota">
        <input type="text" id="kelas" placeholder="Kelas">
        <input type="tel" id="hp" placeholder="No HP">
        <button class="btn" onclick="daftarAnggota()">Daftar Sekarang</button>
        <p id="statusDaftar" style="margin-top:10px; color:green;"></p>
      </div>
    </div>

    <!-- TAB 2: PEMINJAMAN -->
    <div id="pinjam" class="tab-content">
      <h2>Pilih Buku Yang Mau Dipinjam</h2>
      <div class="buku-grid" id="daftarBuku"></div>
    </div>

    <!-- TAB 3: PENGEMBALIAN -->
    <div id="kembali" class="tab-content">
      <h2>Buku Yang Sedang Dipinjam</h2>
      <div id="riwayatPinjam" class="riwayat">
        <p>Belum ada buku yang dipinjam</p>
      </div>
    </div>
  </div>

  <!-- POP UP KONFIRMASI -->
  <div class="popup" id="popupKonfirmasi">
    <div class="popup-box">
      <h3>🤔 Konfirmasi Peminjaman</h3>
      <p id="teksPopup"></p>
      <button class="btn-oke" onclick="okePinjam()">OKE, PINJAM</button>
      <button class="btn-tidak" onclick="tutupPopup()">BATAL</button>
    </div>
  </div>

<script>
  // DATA BUKU CONTOH
  const buku = [
    {id: 1, judul: "Laskar Pelangi", pengarang: "Andrea Hirata"},
    {id: 2, judul: "Bumi", pengarang: "Tere Liye"},
    {id: 3, judul: "Matematika Kelas 7", pengarang: "Kemendikbud"},
    {id: 4, judul: "IPA Terpadu", pengarang: "Kemendikbud"},
    {id: 5, judul: "Harry Potter", pengarang: "J.K. Rowling"},
    {id: 6, judul: "Filosofi Teras", pengarang: "Henry Manampiring"}
  ];

  let bukuDipilih = null;
  let dataAnggota = JSON.parse(localStorage.getItem('anggota')) || [];
  let dataPinjam = JSON.parse(localStorage.getItem('pinjam')) || [];

  // FUNGSI TAB
  function bukaTab(id) {
    document.querySelectorAll('.tab-content').forEach(t => t.classList.remove('active'));
    document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
    document.getElementById(id).classList.add('active');
    event.target.classList.add('active');
    if(id === 'pinjam') tampilkanBuku();
    if(id === 'kembali') tampilkanRiwayat();
  }

  // 1. PENDAFTARAN
  function daftarAnggota() {
    const nama = document.getElementById('nama').value;
    const nis = document.getElementById('nis').value;
    if(nama === '' || nis === '') {alert('Nama dan NIS wajib diisi!'); return;}
    
    dataAnggota.push({nama, nis, kelas: document.getElementById('kelas').value, hp: document.getElementById('hp').value});
    localStorage.setItem('anggota', JSON.stringify(dataAnggota));
    document.getElementById('statusDaftar').innerText = '✅ Pendaftaran Berhasil!';
    document.querySelectorAll('#daftar input').forEach(i => i.value = '');
  }

  // 2. PEMINJAMAN
  function tampilkanBuku() {
    const grid = document.getElementById('daftarBuku');
    grid.innerHTML = '';
    buku.forEach(b => {
      grid.innerHTML += `
        <div class="card">
          <h3>${b.judul}</h3>
          <p>👤 ${b.pengarang}</p>
          <button class="btn" onclick="konfirmasiPinjam(${b.id}, '${b.judul}')">Pinjam Buku</button>
        </div>
      `;
    });
  }

  function konfirmasiPinjam(id, judul) {
    bukuDipilih = {id, judul, tanggal: new Date().toLocaleDateString('id-ID')};
    document.getElementById('teksPopup').innerText = `Yakin mau pinjam buku "${judul}"?`;
    document.getElementById('popupKonfirmasi').style.display = 'flex';
  }

  function okePinjam() {
    dataPinjam.push(bukuDipilih);
    localStorage.setItem('pinjam', JSON.stringify(dataPinjam));
    alert(`✅ Berhasil! Buku "${bukuDipilih.judul}" sudah dipinjam`);
    tutupPopup();
  }

  function tutupPopup() {
    document.getElementById('popupKonfirmasi').style.display = 'none';
  }

  // 3. PENGEMBALIAN
  function tampilkanRiwayat() {
    const div = document.getElementById('riwayatPinjam');
    if(dataPinjam.length === 0) {
      div.innerHTML = '<p>Belum ada buku yang dipinjam</p>';
      return;
    }
    div.innerHTML = '';
    dataPinjam.forEach((p, i) => {
      div.innerHTML += `
        <div class="item-pinjam">
          <div>
            <b>${p.judul}</b><br>
            <small>Tanggal Pinjam: ${p.tanggal}</small>
          </div>
          <button class="btn" style="width:auto; background:#28a745" onclick="kembalikan(${i})">Kembalikan</button>
        </div>
      `;
    });
  }

  function kembalikan(index) {
    if(confirm('Yakin mau mengembalikan buku ini?')) {
      dataPinjam.splice(index, 1);
      localStorage.setItem('pinjam', JSON.stringify(dataPinjam));
      tampilkanRiwayat();
      alert('✅ Buku berhasil dikembalikan!');
    }
  }
</script>
</body>
</html>
